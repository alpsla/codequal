{
  "name": "@codequal/agents",
  "version": "9.0.0",
  "description": "V9 Two-Branch Analyzer - Production Implementation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "require": "./dist/services/index.js",
      "import": "./dist/services/index.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "require": "./dist/services/*.js",
      "import": "./dist/services/*.js"
    },
    "./two-branch/*": {
      "types": "./dist/two-branch/*.d.ts",
      "require": "./dist/two-branch/*.js",
      "import": "./dist/two-branch/*.js"
    },
    "./multi-agent": {
      "types": "./dist/multi-agent/index.d.ts",
      "require": "./dist/multi-agent/index.js",
      "import": "./dist/multi-agent/index.js"
    },
    "./multi-agent/*": {
      "types": "./dist/multi-agent/*.d.ts",
      "require": "./dist/multi-agent/*.js",
      "import": "./dist/multi-agent/*.js"
    },
    "./multi-agent/types": {
      "types": "./dist/multi-agent/types/index.d.ts",
      "require": "./dist/multi-agent/types/index.js",
      "import": "./dist/multi-agent/types/index.js"
    },
    "./multi-agent/types/*": {
      "types": "./dist/multi-agent/types/*.d.ts",
      "require": "./dist/multi-agent/types/*.js",
      "import": "./dist/multi-agent/types/*.js"
    },
    "./fix-agent": {
      "types": "./dist/fix-agent/index.d.ts",
      "require": "./dist/fix-agent/index.js",
      "import": "./dist/fix-agent/index.js"
    },
    "./fix-agent/*": {
      "types": "./dist/fix-agent/*.d.ts",
      "require": "./dist/fix-agent/*.js",
      "import": "./dist/fix-agent/*.js"
    },
    "./fix-agent/agents/*": {
      "types": "./dist/fix-agent/agents/*.d.ts",
      "require": "./dist/fix-agent/agents/*.js",
      "import": "./dist/fix-agent/agents/*.js"
    },
    "./fix-agent/fix-pattern-registry": {
      "types": "./dist/fix-agent/fix-pattern-registry/index.d.ts",
      "require": "./dist/fix-agent/fix-pattern-registry/index.js",
      "import": "./dist/fix-agent/fix-pattern-registry/index.js"
    },
    "./fix-agent/state": {
      "types": "./dist/fix-agent/state/index.d.ts",
      "require": "./dist/fix-agent/state/index.js",
      "import": "./dist/fix-agent/state/index.js"
    }
  },
  "scripts": {
    "prebuild": "cd ../database && npm run build && cd ../core && npm run build && cd ../mcp-hybrid && npm run build && cd ../agents",
    "build": "npm run prebuild && tsc --skipLibCheck",
    "clean": "rm -rf dist",
    "test": "echo 'Use integration tests only'",
    "test:v9:full": "ENABLE_SPOTBUGS=true NODE_ENV=test npx ts-node src/two-branch/tests/__tests__/test-v9-full-regression-with-spotbugs.ts",
    "test:v9:quick": "npx ts-node src/two-branch/tests/__tests__/test-v9-optimized-report.ts",
    "test:v9:integration": "ENABLE_SPOTBUGS=true NODE_ENV=test npx ts-node src/two-branch/tests/__tests__/test-v9-complete-integration.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "single-test": "npx ts-node scripts/run-single-test.ts",
    "download-reports": "npx ts-node scripts/download-v9-reports.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.6.0",
    "cron": "^3.1.7",
    "dotenv": "^16.3.1",
    "glob": "^7.1.7",
    "ioredis": "^5.3.0",
    "node-cron": "^3.0.3",
    "openai": "^4.0.0",
    "redis": "^4.6.0",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cron": "^2.4.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/xml2js": "^0.4.14",
    "lodash": "^4.17.19",
    "typescript": "^5.0.0"
  }
}
