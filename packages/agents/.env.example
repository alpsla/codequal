# Environment Variables Template for CodeQual Agents
# Copy this file to .env and fill in your values

# ============================================================================
# PostgreSQL Configuration (Oracle Cloud - Dependency-Check NVD Database)
# ============================================================================
# Use localhost for local connections on Oracle Cloud server
# Use 129.213.49.128 for external connections (Docker, API services)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nvd_user
POSTGRES_DB=nvd
POSTGRES_PASSWORD=postgres123
DATABASE_URL=postgresql://nvd_user:postgres123@localhost:5432/nvd

# ============================================================================
# Redis Configuration (Oracle Cloud - Caching)
# ============================================================================
REDIS_HOST=10.116.0.7
REDIS_PORT=6379
REDIS_URL=redis://10.116.0.7:6379

# ============================================================================
# OpenRouter API (AI Enrichment - Required for V9 Reports)
# ============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================================
# Debug Mode (Disable rate limiting for E2E tests)
# ============================================================================
DEBUG_MODE=true

# ============================================================================
# Optional: Supabase Configuration (if using Supabase for model config)
# ============================================================================
# SUPABASE_URL=your_supabase_url_here
# SUPABASE_KEY=your_supabase_key_here

# ============================================================================
# Optional: GitHub Configuration (for PR analysis)
# ============================================================================
# GITHUB_TOKEN=your_github_token_here

# ============================================================================
# Cloud API Tools - Corgea (Session 60, Updated Session 63)
# ============================================================================
# Corgea AI Fixer - generates AI-powered code fixes
# Get API key from: https://corgea.com/
#
# IMPORTANT: Use www.corgea.app NOT api.corgea.app (times out)
# Free tier includes API access! Tested 2025-12-20
#
# CORGEA_API_KEY=your_corgea_api_key_here
# CORGEA_API_URL=https://www.corgea.app/api/v1
# CORGEA_MAX_WAIT_TIME=120000
# CORGEA_POLL_INTERVAL=5000

# ============================================================================
# Subscription Tier Configuration
# ============================================================================
# SUBSCRIPTION_TIER=basic  # Options: basic, pro, enterprise
# - basic: CLI tools only (free)
# - pro: CLI + Cloud API fixers (Corgea)
# - enterprise: Unlimited cloud fixes + priority queue

# ============================================================================
# Notes:
# ============================================================================
# 1. Never commit this file to version control (.env is in .gitignore)
# 2. For production, use strong passwords and proper secrets management
# 3. PostgreSQL HOST:
#    - Use "localhost" when running on Oracle Cloud server
#    - Use "129.213.49.128" when connecting from external services
# 4. NVD Database:
#    - First run will download NVD data (~5-10 minutes)
#    - Subsequent runs will use cached data (fast)
# 5. See ORACLE_CLOUD_DB_CONFIG.md for detailed configuration guide
