# Quick Ruby container for AMD64
FROM ruby:3.2-slim

# Install essential dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Ruby analysis tools
RUN gem install \
    bundler-audit \
    brakeman \
    rubocop \
    reek \
    --no-document

WORKDIR /workspace

CMD ["ruby", "--version"]