# CodeQual Working Analyzer
# Essential tools that work immediately
FROM node:20-bullseye

LABEL maintainer="CodeQual Team" \
      version="1.0.0-working" \
      description="Working analyzer with core tools"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Python and essentials
    python3 python3-pip \
    # Java for Java analysis
    openjdk-17-jdk-headless \
    # Git for repo operations
    git \
    # Build tools
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Python tools (tested and working)
RUN pip3 install \
    bandit \
    pylint \
    black \
    mypy \
    isort

# JavaScript/TypeScript tools (tested and working)
RUN npm install -g \
    eslint \
    prettier \
    typescript \
    @typescript-eslint/parser \
    @typescript-eslint/eslint-plugin

# Set working directory
WORKDIR /app

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "console.log('healthy')" || exit 1

# Default command
CMD ["sh", "-c", "echo 'CodeQual analyzer ready with:'; echo '- Python tools: bandit, pylint, black, mypy, isort'; echo '- JS/TS tools: eslint, prettier, typescript'; echo '- Java: JDK 17'; while true; do sleep 30; echo 'Running...'; done"]