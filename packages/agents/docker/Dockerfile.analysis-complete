# CodeQual Complete Analysis Image
# Version: 1.0.0
# Date: 2025-09-03
# Purpose: Cloud pod with all analysis tools (92% coverage)

FROM node:20-slim AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    unzip \
    build-essential \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    python3-venv \
    openjdk-17-jdk \
    maven \
    gradle \
    ruby \
    ruby-dev \
    php \
    php-xml \
    php-mbstring \
    golang-go \
    clang \
    clang-tidy \
    clang-format \
    cppcheck \
    doxygen \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup component add clippy rustfmt

# Create tools directory
RUN mkdir -p /tools /analysis /cache

# ============================================
# JAVA TOOLS (9 tools for enterprise support)
# ============================================
WORKDIR /tools

# PMD - Code analysis
RUN wget -q https://github.com/pmd/pmd/releases/download/pmd_releases%2F7.7.0/pmd-dist-7.7.0-bin.zip && \
    unzip -q pmd-dist-7.7.0-bin.zip && \
    rm pmd-dist-7.7.0-bin.zip

# Checkstyle - Code standards
RUN wget -q https://github.com/checkstyle/checkstyle/releases/download/checkstyle-10.20.2/checkstyle-10.20.2-all.jar

# SpotBugs - Bug detection
RUN wget -q https://github.com/spotbugs/spotbugs/releases/download/4.8.6/spotbugs-4.8.6.tgz && \
    tar -xzf spotbugs-4.8.6.tgz && \
    rm spotbugs-4.8.6.tgz

# OWASP Dependency Check
RUN wget -q https://github.com/jeremylong/DependencyCheck/releases/download/v11.1.0/dependency-check-11.1.0-release.zip && \
    unzip -q dependency-check-11.1.0-release.zip && \
    rm dependency-check-11.1.0-release.zip

# Google Java Format
RUN wget -q https://github.com/google/google-java-format/releases/download/v1.25.0/google-java-format-1.25.0-all-deps.jar

# Error Prone
RUN wget -q https://repo1.maven.org/maven2/com/google/errorprone/error_prone_core/2.36.0/error_prone_core-2.36.0-with-dependencies.jar

# FindSecBugs plugin
RUN wget -q https://github.com/find-sec-bugs/find-sec-bugs/releases/download/version-1.13.0/findsecbugs-plugin-1.13.0.jar

# JaCoCo
RUN wget -q https://repo1.maven.org/maven2/org/jacoco/jacoco/0.8.13/jacoco-0.8.13.zip && \
    unzip -q jacoco-0.8.13.zip -d jacoco && \
    rm jacoco-0.8.13.zip

# NullAway
RUN wget -q https://repo1.maven.org/maven2/com/uber/nullaway/nullaway/0.12.2/nullaway-0.12.2.jar

# ============================================
# PYTHON TOOLS (17 tools)
# ============================================
RUN pip3 install --no-cache-dir --break-system-packages \
    bandit \
    safety \
    pylint \
    mypy \
    black \
    flake8 \
    isort \
    autopep8 \
    vulture \
    prospector \
    radon \
    xenon \
    py-spy \
    pydeps \
    import-linter \
    pip-audit \
    cpplint \
    memory-profiler \
    line_profiler

# ============================================
# JAVASCRIPT/TYPESCRIPT TOOLS (10 tools)
# ============================================
RUN npm install -g \
    eslint \
    prettier \
    jshint \
    jscpd \
    madge \
    dependency-cruiser \
    lighthouse \
    webpack-bundle-analyzer \
    npm-check-updates \
    eslint-plugin-security \
    eslint-plugin-sonarjs \
    typescript \
    @typescript-eslint/parser \
    @typescript-eslint/eslint-plugin

# ============================================
# GO TOOLS (12 tools)
# ============================================
ENV GOPATH=/root/go
ENV PATH="${GOPATH}/bin:${PATH}"

RUN go install github.com/securego/gosec/v2/cmd/gosec@latest && \
    go install honnef.co/go/tools/cmd/staticcheck@latest && \
    go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest && \
    go install github.com/kisielk/errcheck@latest && \
    go install golang.org/x/lint/golint@latest && \
    go install github.com/go-critic/go-critic/cmd/gocritic@latest && \
    go install mvdan.cc/gofumpt@latest && \
    go install github.com/google/pprof@latest && \
    go install github.com/ofabry/go-callvis@latest && \
    go install github.com/loov/goda@latest && \
    go install github.com/sonatype-nexus-community/nancy@latest

# ============================================
# RUST TOOLS (18 tools)
# ============================================
RUN cargo install --locked \
    cargo-audit \
    cargo-deny \
    cargo-outdated \
    cargo-license \
    cargo-geiger \
    cargo-nextest \
    cargo-watch \
    cargo-make \
    cargo-expand \
    cargo-deps \
    cargo-modules \
    cargo-criterion \
    hyperfine \
    flamegraph

# ============================================
# RUBY TOOLS (9 tools)
# ============================================
RUN gem install \
    brakeman \
    bundler-audit \
    rubocop \
    reek \
    flog \
    flay \
    ruby-lint \
    fasterer \
    debride

# ============================================
# PHP TOOLS (7 tools)
# ============================================
# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Install PHP tools globally
RUN composer global require \
    vimeo/psalm \
    phpstan/phpstan \
    squizlabs/php_codesniffer \
    phpmd/phpmd \
    phploc/phploc \
    sebastian/phpcpd \
    phpmetrics/phpmetrics

ENV PATH="/root/.composer/vendor/bin:${PATH}"

# ============================================
# UNIVERSAL TOOLS
# ============================================
RUN pip3 install --no-cache-dir --break-system-packages semgrep

# Trivy - Container/dependency scanning
RUN wget -qO- https://github.com/aquasecurity/trivy/releases/download/v0.45.0/trivy_0.45.0_Linux-64bit.tar.gz | \
    tar -xzf - -C /usr/local/bin trivy

# Gitleaks - Secret scanning
RUN wget -q https://github.com/gitleaks/gitleaks/releases/download/v8.22.1/gitleaks_8.22.1_linux_x64.tar.gz && \
    tar -xzf gitleaks_8.22.1_linux_x64.tar.gz -C /usr/local/bin && \
    rm gitleaks_8.22.1_linux_x64.tar.gz

# ============================================
# PATH Configuration
# ============================================
ENV PATH="/tools/pmd-bin-7.7.0/bin:/tools/spotbugs-4.8.6/bin:/tools/dependency-check/bin:${PATH}"
ENV PATH="/root/.cargo/bin:/root/go/bin:/root/.composer/vendor/bin:${PATH}"

# Create wrapper scripts for Java tools
RUN echo '#!/bin/bash\njava -jar /tools/checkstyle-10.20.2-all.jar "$@"' > /usr/local/bin/checkstyle && \
    chmod +x /usr/local/bin/checkstyle && \
    echo '#!/bin/bash\njava -jar /tools/google-java-format-1.25.0-all-deps.jar "$@"' > /usr/local/bin/google-java-format && \
    chmod +x /usr/local/bin/google-java-format

# ============================================
# Verification Script
# ============================================
COPY <<EOF /tools/verify-installation.sh
#!/bin/bash
echo "=== Tool Installation Verification ==="
echo "Java Tools:"
which pmd spotbugs checkstyle google-java-format
echo "Python Tools:"
which bandit safety pylint mypy black
echo "JavaScript Tools:"
which eslint prettier jshint madge
echo "Go Tools:"
which gosec staticcheck golangci-lint
echo "Rust Tools:"
which cargo-audit cargo-deny rustfmt clippy
echo "Ruby Tools:"
which brakeman rubocop
echo "PHP Tools:"
which psalm phpstan phpcs
echo "Universal Tools:"
which semgrep trivy gitleaks
echo "=== Verification Complete ==="
EOF

RUN chmod +x /tools/verify-installation.sh

# Set working directory
WORKDIR /analysis

# Add health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD which pmd && which eslint && which bandit || exit 1

# Labels
LABEL maintainer="CodeQual Team"
LABEL version="1.0.0"
LABEL description="Complete analysis environment with 92% tool coverage"
LABEL tools.count="85"
LABEL tools.languages="Java,JavaScript,TypeScript,Python,Go,Rust,Ruby,PHP,C++"

# Default command
CMD ["/bin/bash"]