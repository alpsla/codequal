# CodeQual Production Core Image
# Optimized for 8GB Kubernetes cluster - Core 25 tools
# Memory: 2.5-3GB | Tools: 25 essential

FROM ubuntu:22.04 as builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git ca-certificates gnupg2 \
    build-essential pkg-config \
    python3.11 python3-pip \
    nodejs npm \
    openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Install Python tools (8 essential from 17)
RUN pip3 install --no-cache-dir \
    semgrep==1.* \
    bandit==1.* \
    pylint==3.* \
    mypy==1.* \
    black==24.* \
    flake8==7.* \
    safety==3.* \
    isort==5.*

# Install JavaScript tools (5 essential from 10)
RUN npm install -g \
    eslint@8 \
    prettier@3 \
    typescript@5 \
    npm-audit-resolver@3 \
    madge@6

# Install universal security tools (7 tools)
RUN pip3 install --no-cache-dir \
    pip-audit==2.* \
    checkov==3.* \
    detect-secrets==1.*

# Install GitLeaks
RUN curl -sSfL https://raw.githubusercontent.com/gitleaks/gitleaks/master/scripts/install.sh | sh -s -- -b /usr/local/bin v8.18.0

# Install Trivy
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin v0.48.0

# Install Snyk (lightweight CLI)
RUN npm install -g snyk@1

# Install SonarScanner
RUN wget -q https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006-linux.zip -O /tmp/sonar.zip && \
    unzip -q /tmp/sonar.zip -d /opt/ && \
    mv /opt/sonar-scanner-* /opt/sonar-scanner && \
    ln -s /opt/sonar-scanner/bin/sonar-scanner /usr/local/bin/sonar-scanner && \
    rm /tmp/sonar.zip

# ============================================
# Final production image
# ============================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONOPTIMIZE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NODE_OPTIONS="--max-old-space-size=1024" \
    ANALYSIS_MODE=production \
    TOOL_SET=core \
    TOOLS_COUNT=25

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip \
    nodejs npm \
    openjdk-17-jre-headless \
    git curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy tools from builder
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=builder /usr/local/lib/python3.11/ /usr/local/lib/python3.11/
COPY --from=builder /usr/lib/node_modules/ /usr/lib/node_modules/
COPY --from=builder /opt/sonar-scanner /opt/sonar-scanner

# Create necessary directories
RUN mkdir -p /analysis /cache /results /tools

# ============================================
# Analysis scripts
# ============================================
COPY <<'EOF' /tools/analyze-core.sh
#!/bin/bash
set -e

PROJECT_PATH=${1:-/analysis}
OUTPUT_DIR=${2:-/results}
MAX_MEMORY=${3:-2048}

echo "🔍 CodeQual Production Core Analysis"
echo "Tools: 25 essential | Memory limit: ${MAX_MEMORY}MB"
echo "----------------------------------------"

# Detect primary language
LANGUAGES=$(find $PROJECT_PATH -type f \( -name "*.py" -o -name "*.js" -o -name "*.ts" -o -name "*.java" \) | \
    head -100 | sed 's/.*\.//' | sort | uniq -c | sort -rn | awk '{print $2}')

PRIMARY_LANG=$(echo $LANGUAGES | awk '{print $1}')
echo "Primary language detected: $PRIMARY_LANG"

mkdir -p $OUTPUT_DIR

# Universal security scans (Always run)
echo "Running universal security scans..."
semgrep --config=auto --json -o $OUTPUT_DIR/semgrep.json $PROJECT_PATH 2>/dev/null || true
gitleaks detect --source $PROJECT_PATH --report-path $OUTPUT_DIR/gitleaks.json -f json 2>/dev/null || true
trivy fs --security-checks vuln,secret --format json -o $OUTPUT_DIR/trivy.json $PROJECT_PATH 2>/dev/null || true

# Language-specific analysis
case $PRIMARY_LANG in
    py)
        echo "Running Python analysis (8 tools)..."
        bandit -r $PROJECT_PATH -f json -o $OUTPUT_DIR/bandit.json 2>/dev/null || true
        pylint $PROJECT_PATH --output-format=json > $OUTPUT_DIR/pylint.json 2>&1 || true
        mypy $PROJECT_PATH --json-report $OUTPUT_DIR 2>/dev/null || true
        flake8 $PROJECT_PATH --format=json --output-file=$OUTPUT_DIR/flake8.json 2>/dev/null || true
        black $PROJECT_PATH --check --diff > $OUTPUT_DIR/black.txt 2>&1 || true
        safety check --json > $OUTPUT_DIR/safety.json 2>&1 || true
        ;;
    
    js|ts)
        echo "Running JavaScript/TypeScript analysis (5 tools)..."
        cd $PROJECT_PATH
        eslint . --ext .js,.jsx,.ts,.tsx -f json -o $OUTPUT_DIR/eslint.json 2>/dev/null || true
        prettier --check "**/*.{js,jsx,ts,tsx}" > $OUTPUT_DIR/prettier.txt 2>&1 || true
        npm audit --json > $OUTPUT_DIR/npm-audit.json 2>&1 || true
        madge --circular --json . > $OUTPUT_DIR/madge.json 2>/dev/null || true
        ;;
    
    *)
        echo "Running generic analysis..."
        ;;
esac

# Infrastructure as Code scanning
if [ -f "$PROJECT_PATH/Dockerfile" ] || [ -f "$PROJECT_PATH/docker-compose.yml" ]; then
    echo "Running container security scan..."
    checkov -d $PROJECT_PATH --output json > $OUTPUT_DIR/checkov.json 2>/dev/null || true
fi

# Calculate coverage
TOTAL_POSSIBLE=85
TOOLS_USED=25
COVERAGE=$((TOOLS_USED * 100 / TOTAL_POSSIBLE))

echo ""
echo "✅ Analysis complete"
echo "Coverage: ${TOOLS_USED}/${TOTAL_POSSIBLE} tools (${COVERAGE}%)"
echo "Results saved to: $OUTPUT_DIR"

# Generate summary
cat > $OUTPUT_DIR/summary.json <<SUMMARY
{
  "environment": "production-core",
  "tools_available": 25,
  "tools_total": 85,
  "coverage_percent": ${COVERAGE},
  "primary_language": "${PRIMARY_LANG}",
  "timestamp": "$(date -Iseconds)"
}
SUMMARY
EOF
RUN chmod +x /tools/analyze-core.sh

# Health check script
COPY <<'EOF' /tools/health.sh
#!/bin/bash
python3.11 --version && \
node --version && \
java -version 2>&1 | head -n1 && \
semgrep --version && \
echo "✅ Core tools operational"
EOF
RUN chmod +x /tools/health.sh

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD /tools/health.sh

WORKDIR /analysis

ENTRYPOINT ["/tools/analyze-core.sh"]
CMD ["/analysis", "/results"]