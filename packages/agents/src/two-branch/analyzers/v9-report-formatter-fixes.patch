+  private async generateFixSuggestion(issue: Issue): Promise<string> {
+    // Try to get fix from fix generator service
+    try {
+      const fixes = await this.fixGenerator.generateFixes(issue.agent || 'quality', [issue]);
+      if (fixes.length > 0) {
+        return fixes[0].codeSnippet || fixes[0].fix;
+      }
+    } catch (error) {
+      // Fall back to template-based fixes
+    }
+
+    const fixes: Record<string, string> = {
+      'SQL Injection': `// Use parameterized queries
+PreparedStatement ps = conn.prepareStatement("SELECT * FROM users WHERE id = ?");
+ps.setInt(1, userId);
+ResultSet rs = ps.executeQuery();`,
+      'Hardcoded credentials': `// Use environment variables or secrets management
+String apiKey = System.getenv("API_KEY");
+// Or use a secrets management service
+String apiKey = secretsManager.getSecret("api-key");`,
+      'High complexity': `// Refactor into smaller methods
+private void processData(Data data) {
+  validateData(data);
+  transformData(data);
+  saveData(data);
+}`,
+      'default': `// Review and fix the ${issue.severity} ${issue.type} issue
+// Consult documentation for ${issue.tool} recommendations`
+    };
+
+    return fixes[issue.title || ''] || fixes.default;
+  }
