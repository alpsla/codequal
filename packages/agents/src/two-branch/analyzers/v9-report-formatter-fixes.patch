+  private calculateRiskMatrix(result: AnalysisResult): any[] {
+    const newIssues = result.newIssues || [];
+
+    return [
+      {
+        category: 'Security',
+        blocking: newIssues.filter(i => i.category === 'Security' && (i.severity === 'critical' || i.severity === 'high')).length,
+        backlog: newIssues.filter(i => i.category === 'Security' && (i.severity === 'medium' || i.severity === 'low')).length,
+        score: this.calculateCategoryRisk('Security', newIssues)
+      },
+      {
+        category: 'Quality',
+        blocking: newIssues.filter(i => i.category === 'Quality' && (i.severity === 'critical' || i.severity === 'high')).length,
+        backlog: newIssues.filter(i => i.category === 'Quality' && (i.severity === 'medium' || i.severity === 'low')).length,
+        score: this.calculateCategoryRisk('Quality', newIssues)
+      },
+      {
+        category: 'Performance',
+        blocking: newIssues.filter(i => i.category === 'Performance' && (i.severity === 'critical' || i.severity === 'high')).length,
+        backlog: newIssues.filter(i => i.category === 'Performance' && (i.severity === 'medium' || i.severity === 'low')).length,
+        score: this.calculateCategoryRisk('Performance', newIssues)
+      }
+    ];
+  }
+
+  private getExploitCostExplanation(result: AnalysisResult): string {
+    const criticalCount = result.newIssues?.filter(i => i.severity === 'critical').length || 0;
+
+    if (criticalCount > 0) {
+      return `Based on ${criticalCount} critical security issue(s) that could lead to data breach, service disruption, or compliance violations`;
+    }
+
+    const highCount = result.newIssues?.filter(i => i.severity === 'high').length || 0;
+    if (highCount > 0) {
+      return `Based on ${highCount} high-severity issue(s) that could impact system availability or data integrity`;
+    }
+
+    return 'Estimated cost of potential security incidents and operational disruptions';
+  }

