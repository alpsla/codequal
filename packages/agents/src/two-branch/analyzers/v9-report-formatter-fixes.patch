+  private getLanguageFromFile(filepath: string): string {
+    const ext = filepath.split('.').pop()?.toLowerCase();
+    const langMap: Record<string, string> = {
+      'js': 'javascript',
+      'ts': 'typescript',
+      'java': 'java',
+      'py': 'python',
+      'go': 'go',
+      'scala': 'scala',
+      'kt': 'kotlin'
+    };
+    return langMap[ext || ''] || 'text';
+  }

