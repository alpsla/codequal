+  private calculateProperScore(result: AnalysisResult, previousScore: number = 100, isFirstAnalysis: boolean = true): any {
+    const newIssues = result.newIssues || [];
+    const existingIssues = result.existingIssues || [];
+    const resolvedIssues = result.resolvedIssues || [];
+
+    const baseScore = isFirstAnalysis ? 100 : previousScore;
+
+    let newDeduction = 0;
+    let existingDeduction = 0;
+    let resolutionBonus = 0;
+
+    newIssues.forEach(issue => {
+      newDeduction += this.severityWeights[issue.severity] || 0;
+    });
+
+    existingIssues.forEach(issue => {
+      existingDeduction += this.severityWeights[issue.severity] || 0;
+    });
+
+    resolvedIssues.forEach(issue => {
+      resolutionBonus += this.severityWeights[issue.severity] || 0;
+    });
+
+    const finalScore = Math.max(0, Math.min(100,
+      baseScore - newDeduction - existingDeduction + resolutionBonus
+    ));
+
+    return {
+      score: finalScore,
+      grade: this.getGrade(finalScore),
+      breakdown: {
+        base: baseScore,
+        newDeduction,
+        existingDeduction,
+        resolutionBonus
+      }
+    };
+  }
+
+  private getGrade(score: number): string {
+    if (score >= 90) return 'A';
+    if (score >= 80) return 'B';
+    if (score >= 70) return 'C';
+    if (score >= 60) return 'D';
+    return 'F';
+  }

