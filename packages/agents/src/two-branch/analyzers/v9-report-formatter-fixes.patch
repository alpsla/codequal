+  private calculateSkillScore(result: AnalysisResult, previousScore: number = 50, isFirstAnalysis: boolean = true): SkillScore {
+    const baseSkillScore = isFirstAnalysis ? 50 : previousScore;
+    const newIssues = result.newIssues || [];
+    const resolvedIssues = result.resolvedIssues || [];
+
+    const categoryScores = {
+      security: baseSkillScore,
+      performance: baseSkillScore,
+      maintainability: baseSkillScore,
+      testing: baseSkillScore,
+      documentation: baseSkillScore
+    };
+
+    // Adjust scores based on issues
+    newIssues.forEach(issue => {
+      const category = this.mapIssueCategoryToSkill(issue.category);
+      if (category && categoryScores[category]) {
+        categoryScores[category] -= this.severityWeights[issue.severity] || 0;
+      }
+    });
+
+    resolvedIssues.forEach(issue => {
+      const category = this.mapIssueCategoryToSkill(issue.category);
+      if (category && categoryScores[category]) {
+        categoryScores[category] += this.severityWeights[issue.severity] || 0;
+      }
+    });
+
+    // Ensure scores are between 0 and 100
+    Object.keys(categoryScores).forEach(key => {
+      categoryScores[key as keyof typeof categoryScores] =
+        Math.max(0, Math.min(100, categoryScores[key as keyof typeof categoryScores]));
+    });
+
+    const overallScore = Object.values(categoryScores).reduce((a, b) => a + b, 0) / 5;
+
+    return {
+      overall: Math.round(overallScore),
+      score: Math.round(overallScore),
+      developer: overallScore >= 80 ? 'senior' : overallScore >= 60 ? 'mid' : 'junior',
+      categories: categoryScores,
+      trend: this.determineTrend(baseSkillScore, overallScore),
+      recommendations: this.generateSkillRecommendations(categoryScores),
+      ...categoryScores
+    };
+  }

