+  private async validateAndGetResources(result: AnalysisResult): Promise<EducationalResource[]> {
+    const resources = result.educationalResources || [];
+
+    for (const resource of resources) {
+      const isValid = await this.validateEducationalLink(resource.url);
+      if (!isValid) {
+        resource.url = this.getFallbackUrl(resource.issueType);
+        resource.title += ' (Alternative Resource)';
+      }
+    }
+
+    return resources;
+  }
+
+  private async validateEducationalLink(url: string): Promise<boolean> {
+    try {
+      const response = await axios.head(url, { timeout: 3000 });
+      return response.status >= 200 && response.status < 400;
+    } catch {
+      return false;
+    }
+  }
+
+  private getFallbackUrl(issueType: string): string {
+    const fallbacks: Record<string, string> = {
+      'SQL Injection': 'https://owasp.org/www-community/attacks/SQL_Injection',
+      'Hardcoded credentials': 'https://owasp.org/www-community/vulnerabilities/Use_of_hard-coded_password',
+      'Security': 'https://owasp.org/www-project-top-ten/',
+      'Performance': 'https://web.dev/performance/',
+      'Quality': 'https://refactoring.guru/',
+      'default': 'https://developer.mozilla.org/en-US/docs/Learn'
+    };
+
+    return fallbacks[issueType] || fallbacks.default;
+  }

