{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@codequal/core": [
        "../core/dist"
      ],
      "@codequal/core/*": [
        "../core/dist/*"
      ],
      "@codequal/database": [
        "../database/dist"
      ],
      "@codequal/database/*": [
        "../database/dist/*"
      ],
      "@codequal/mcp-hybrid": [
        "../mcp-hybrid/dist"
      ],
      "@codequal/mcp-hybrid/*": [
        "../mcp-hybrid/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/tests/**",
    "**/archive/**",
    "**/deprecated/**",
    "**/_archived/**",
    "**/_archived_supabase_cve/**"
  ]
}