FROM golang:1.21-alpine

WORKDIR /app

# Install build tools and git
RUN apk add --no-cache git gcc musl-dev

# Install Go analysis tools with compatible versions for Go 1.21
RUN go install github.com/golangci/golangci-lint/cmd/golangci-lint@v1.54.2 && \
    go install golang.org/x/tools/cmd/goimports@v0.13.0 && \
    go install honnef.co/go/tools/cmd/staticcheck@v0.4.6 && \
    go install github.com/securego/gosec/v2/cmd/gosec@v2.18.2 && \
    go install github.com/fzipp/gocyclo/cmd/gocyclo@v0.6.0 && \
    go install github.com/go-critic/go-critic/cmd/gocritic@v0.9.0 && \
    go install github.com/mgechev/revive@v1.3.4

# Create golangci-lint config optimized for structured JSON output with file:line info
RUN cat > /app/.golangci.yml << 'EOF'
run:
  timeout: 5m
  tests: false
  go: "1.21"

output:
  format: json
  print-issued-lines: true
  print-linter-name: true
  uniq-by-line: true
  path-prefix: ""
  sort-results: true

linters:
  disable-all: true
  enable:
    - gosec
    - govet
    - ineffassign
    - unused
    - gosimple
    - gocyclo
    - gofmt
    - goimports
    - revive
    - gocritic
    - staticcheck

linters-settings:
  gosec:
    severity: medium
    confidence: medium
    excludes:
      - G104 # Errors unhandled (too many false positives)
    includes:
      - G101  # Look for hard coded credentials
      - G102  # Bind to all interfaces
      - G103  # Audit the use of unsafe block
      - G106  # Audit the use of ssh.InsecureIgnoreHostKey
      - G107  # Url provided to HTTP request as taint input
      - G108  # Profiling endpoint automatically exposed
      - G109  # Potential Integer overflow made by strconv.Atoi result conversion
      - G110  # Potential DoS vulnerability via decompression bomb
  gocyclo:
    min-complexity: 15
  revive:
    severity: warning
    rules:
      - name: exported
        severity: warning
        disabled: false
        arguments:
          - "checkPrivateReceivers"
          - "sayRepetitiveInsteadOfStutters"
      - name: var-naming
      - name: package-comments
      - name: blank-imports
      - name: context-as-argument
      - name: dot-imports
      - name: error-return
      - name: error-strings
      - name: error-naming
      - name: increment-decrement
      - name: var-declaration
      - name: range-loop-pointer
      - name: receiver-naming
      - name: time-naming
      - name: unexported-return
      - name: indent-error-flow
      - name: errorf
      - name: empty-block
      - name: superfluous-else
      - name: unused-parameter
      - name: unreachable-code
      - name: redefines-builtin-id
  gocritic:
    enabled-tags:
      - diagnostic
      - style
      - performance
    disabled-checks:
      - unnamedResult
      - hugeParam
  staticcheck:
    checks: ["all", "-ST1000", "-ST1003", "-ST1016", "-ST1020", "-ST1021", "-ST1022"]

issues:
  exclude-use-default: false
  max-issues-per-linter: 0
  max-same-issues: 0
  new: false
  fix: false
EOF

# Create a wrapper script that ensures proper JSON output with file:line format
RUN cat > /usr/local/bin/golangci-lint-json << 'EOF'
#!/bin/sh
# Wrapper script for golangci-lint to ensure consistent JSON output
CONFIG_FILE="${GOLANGCI_CONFIG_FILE:-/app/.golangci.yml}"
TIMEOUT="${GOLANGCI_TIMEOUT:-5m}"

# Run golangci-lint with explicit JSON format and error handling
golangci-lint run \
  --config="$CONFIG_FILE" \
  --timeout="$TIMEOUT" \
  --out-format=json \
  --print-issued-lines \
  --print-linter-name \
  --sort-results \
  --new=false \
  --fix=false \
  "$@" 2>&1 | jq -c '
    if type == "object" and has("Issues") then
      .Issues[] | {
        "file": .Pos.Filename,
        "line": .Pos.Line,
        "column": .Pos.Column,
        "severity": (if .Severity then .Severity else "warning" end),
        "message": .Text,
        "rule": .FromLinter,
        "ruleId": .RuleId
      }
    else
      empty
    end
  ' 2>/dev/null || echo '{"error": "golangci-lint analysis failed or no issues found"}'
EOF

RUN chmod +x /usr/local/bin/golangci-lint-json

# Install jq for JSON processing
RUN apk add --no-cache jq

# Test configuration and installations
RUN go version && \
    golangci-lint --version && \
    gosec --version && \
    staticcheck --version && \
    jq --version && \
    echo "Go v4.2 container ready with optimized file:line JSON support"

CMD ["go", "version"]