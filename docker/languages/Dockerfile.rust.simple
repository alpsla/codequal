FROM rust:1.75-slim

# Install basic tools only - NO CARGO TOOLS COMPILATION
RUN apt-get update && apt-get install -y git curl && \
    rm -rf /var/lib/apt/lists/*

# Simple pattern-based scanners (no compilation)
RUN echo '#!/bin/bash\ngrep -rn "unsafe\s*{" --include="*.rs" . 2>/dev/null | head -20' > /usr/local/bin/check-unsafe && \
    echo '#!/bin/bash\ncargo tree 2>/dev/null || echo "No Cargo.toml found"' > /usr/local/bin/check-deps && \
    chmod +x /usr/local/bin/check-*

WORKDIR /app
CMD ["bash"]
