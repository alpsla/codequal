# Quality Agent Container
# Handles code quality and best practices fix suggestions
# This agent handles ~89% of all issues, so needs robust error handling
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 py3-pip make g++

# Create package.json for agent
RUN echo '{\
  "name": "@codequal/quality-agent",\
  "version": "9.0.0",\
  "description": "Code quality fix generation agent for CodeQual",\
  "main": "dist/index.js",\
  "scripts": {\
    "start": "node dist/index.js",\
    "build": "tsc",\
    "dev": "ts-node src/index.ts"\
  }\
}' > package.json

# Install dependencies with retry logic for reliability
RUN npm install --save \
    openai@4.38.5 \
    ioredis@5.3.2 \
    @grpc/grpc-js@1.10.1 \
    @grpc/proto-loader@0.7.10 \
    winston@3.11.0 \
    dotenv@16.3.1 \
    p-queue@7.4.1 \
    p-retry@5.1.2

# Install dev dependencies
RUN npm install --save-dev \
    typescript@5.3.3 \
    @types/node@20.11.19 \
    ts-node@10.9.2

# Copy agent source code
COPY packages/agents/src/two-branch/agents/specialized-agents.ts src/agents/
COPY packages/agents/src/two-branch/architecture/hybrid-fix-architecture.ts src/architecture/
COPY packages/agents/src/two-branch/services/dynamic-model-selector.ts src/services/

# Create main entry point with enhanced error handling
RUN echo 'import { CodeQualityAgent } from "./agents/specialized-agents";\
import { HybridFixService } from "./architecture/hybrid-fix-architecture";\
import * as grpc from "@grpc/grpc-js";\
import * as protoLoader from "@grpc/proto-loader";\
import winston from "winston";\
import PQueue from "p-queue";\
import pRetry from "p-retry";\
\
const logger = winston.createLogger({\
  level: process.env.LOG_LEVEL || "info",\
  format: winston.format.combine(\
    winston.format.timestamp(),\
    winston.format.errors({ stack: true }),\
    winston.format.json()\
  ),\
  transports: [new winston.transports.Console()]\
});\
\
const agent = new CodeQualityAgent();\
const service = new HybridFixService();\
\
// Create queue for handling high volume (89% of issues)\
const queue = new PQueue({\
  concurrency: parseInt(process.env.CONCURRENCY || "10"),\
  timeout: 30000,\
  throwOnTimeout: true\
});\
\
// gRPC server setup\
const server = new grpc.Server({\
  "grpc.max_receive_message_length": 50 * 1024 * 1024, // 50MB\
  "grpc.max_send_message_length": 50 * 1024 * 1024\
});\
\
const PORT = process.env.PORT || 50051;\
\
server.bindAsync(\
  `0.0.0.0:${PORT}`,\
  grpc.ServerCredentials.createInsecure(),\
  (err, port) => {\
    if (err) {\
      logger.error("Failed to start gRPC server:", err);\
      process.exit(1);\
    }\
    logger.info(`Quality Agent listening on port ${port}`);\
    logger.info(`Queue concurrency: ${queue.concurrency}`);\
    server.start();\
  }\
);\
\
// Health check endpoint with queue status\
const healthCheck = (call: any, callback: any) => {\
  callback(null, {\
    status: "healthy",\
    agent: "quality",\
    version: "9.0.0",\
    queueSize: queue.size,\
    queuePending: queue.pending\
  });\
};\
\
// Fix generation with retry logic\
const generateFix = async (call: any, callback: any) => {\
  try {\
    const issue = call.request;\
    \
    // Use queue to manage load\
    const fix = await queue.add(async () => {\
      return pRetry(\
        async () => agent.generateFixSuggestion(issue),\
        {\
          retries: 3,\
          onFailedAttempt: (error) => {\
            logger.warn(`Fix generation attempt ${error.attemptNumber} failed:`, error.message);\
          }\
        }\
      );\
    });\
    \
    callback(null, fix);\
  } catch (error) {\
    logger.error("Fix generation failed after retries:", error);\
    callback(error);\
  }\
};\
\
// Graceful shutdown\
process.on("SIGTERM", async () => {\
  logger.info("SIGTERM received, draining queue...");\
  queue.pause();\
  await queue.onIdle();\
  server.tryShutdown(() => {\
    logger.info("Server shutdown complete");\
    process.exit(0);\
  });\
});' > src/index.ts

# Create TypeScript config
RUN echo '{\
  "compilerOptions": {\
    "target": "ES2022",\
    "module": "commonjs",\
    "lib": ["ES2022"],\
    "outDir": "./dist",\
    "rootDir": "./src",\
    "strict": true,\
    "esModuleInterop": true,\
    "skipLibCheck": true,\
    "forceConsistentCasingInFileNames": true,\
    "resolveJsonModule": true,\
    "moduleResolution": "node",\
    "types": ["node"]\
  },\
  "include": ["src/**/*"],\
  "exclude": ["node_modules", "dist"]\
}' > tsconfig.json

# Build the application
RUN npm run build

# Environment variables
ENV NODE_ENV=production \
    PORT=50051 \
    REDIS_URL=redis://redis-cache:6379 \
    BATCH_SIZE=50 \
    CACHE_TTL=604800 \
    CONCURRENCY=10 \
    LOG_LEVEL=info

# Expose gRPC port
EXPOSE 50051

# Health check with higher timeout for high-volume agent
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('net').createConnection(50051, 'localhost').on('connect', () => process.exit(0)).on('error', () => process.exit(1))"

# Run the agent with increased memory
CMD ["node", "--max-old-space-size=2048", "dist/index.js"]