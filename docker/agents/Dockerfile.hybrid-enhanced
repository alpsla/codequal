FROM node:20-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache python3 py3-pip make g++ git

# Create package.json
RUN echo '{\
  "name": "@codequal/hybrid-agent-enhanced",\
  "version": "2.0.0",\
  "description": "Enhanced hybrid agent with tool execution",\
  "main": "src/index.js",\
  "scripts": {\
    "start": "node src/index.js",\
    "dev": "node src/index.js"\
  }\
}' > package.json

# Install production dependencies
RUN npm install --save \
    openai@4.38.5 \
    ioredis@5.3.2 \
    @grpc/grpc-js@1.10.1 \
    @grpc/proto-loader@0.7.10 \
    winston@3.11.0 \
    dotenv@16.3.1 \
    express@4.18.2 \
    p-queue@7.4.1 \
    p-retry@5.1.2 \
    @supabase/supabase-js@2.39.3 \
    zod@3.22.4 \
    axios@1.6.7 \
    marked@11.1.1

# Create source directory
RUN mkdir -p src

# Copy enhanced services
COPY hybrid-agent-enhanced.js src/index.js
COPY cache-service.js src/cache-service.js || echo "Cache service will be created"
COPY agent-service.js src/agent-service.js || echo "Agent service will be created"

# Create cache service if not exists
RUN if [ ! -f src/cache-service.js ]; then \
    cat > src/cache-service.js << 'EOF' && \
const Redis = require('ioredis');
const crypto = require('crypto');

class HybridCacheService {
  constructor() {
    this.redis = new Redis(process.env.REDIS_URL || 'redis://localhost:6379');
    this.patterns = new Map();
    this.hitRate = { hits: 0, misses: 0 };
  }

  async getFixForIssue(issue) {
    const cacheKey = this.generateCacheKey(issue);
    try {
      const cached = await this.redis.get(cacheKey);
      if (cached) {
        this.hitRate.hits++;
        console.log(`Cache HIT for ${issue.type}:${issue.category} (${this.getHitRate()}% hit rate)`);
        return JSON.parse(cached);
      }
      this.hitRate.misses++;
      console.log(`Cache MISS for ${issue.type}:${issue.category} (${this.getHitRate()}% hit rate)`);
      return null;
    } catch (error) {
      console.error('Cache error:', error);
      return null;
    }
  }

  async storeFix(issue, fix) {
    const cacheKey = this.generateCacheKey(issue);
    const ttl = this.getTTL(issue);
    try {
      await this.redis.setex(cacheKey, ttl, JSON.stringify(fix));
      console.log(`Cached fix for ${issue.type}:${issue.category} (TTL: ${ttl}s)`);
    } catch (error) {
      console.error('Failed to cache fix:', error);
    }
  }

  generateCacheKey(issue) {
    const parts = [
      issue.tool || 'unknown',
      issue.type || 'unknown',
      issue.category || 'general',
      issue.language || 'any'
    ];
    return `fix:${parts.join(':')}:${crypto.createHash('md5').update(JSON.stringify(issue)).digest('hex')}`;
  }

  getTTL(issue) {
    if (issue.confidence === 'high') return 604800; // 7 days
    if (issue.confidence === 'medium') return 86400; // 1 day
    return 3600; // 1 hour
  }

  getHitRate() {
    const total = this.hitRate.hits + this.hitRate.misses;
    if (total === 0) return 0;
    return Math.round((this.hitRate.hits / total) * 100);
  }
}

module.exports = HybridCacheService;
EOF
    echo "Created cache-service.js"; \
fi

# Create agent service if not exists
RUN if [ ! -f src/agent-service.js ]; then \
    cat > src/agent-service.js << 'EOF' && \
const OpenAI = require('openai');

class AgentService {
  constructor(agentType) {
    this.agentType = agentType;
    this.openai = new OpenAI({
      apiKey: process.env.OPENROUTER_API_KEY,
      baseURL: "https://openrouter.ai/api/v1"
    });
  }

  async generateFix(issue) {
    const prompt = this.buildPrompt(issue);
    try {
      const response = await this.openai.chat.completions.create({
        model: this.selectModel(issue),
        messages: [
          { role: "system", content: this.getSystemPrompt() },
          { role: "user", content: prompt }
        ],
        temperature: 0.3,
        max_tokens: 500
      });

      return {
        fix: response.choices[0].message.content,
        confidence: this.calculateConfidence(issue),
        explanation: `Fix generated by ${this.agentType} agent`,
        timestamp: new Date().toISOString()
      };
    } catch (error) {
      console.error(`Agent ${this.agentType} error:`, error);
      throw error;
    }
  }

  buildPrompt(issue) {
    return `Generate a code fix for this ${issue.type} issue in ${issue.language || 'Java'}:
Tool: ${issue.tool}
Category: ${issue.category}
Message: ${issue.message}
File: ${issue.file}
Line: ${issue.line}

Provide:
1. Explanation of the issue
2. Actual code snippet to fix it
3. Why this fix works`;
  }

  getSystemPrompt() {
    const prompts = {
      security: "You are a security expert. Provide secure code fixes with actual code snippets.",
      performance: "You are a performance expert. Provide optimized code fixes with actual code.",
      quality: "You are a code quality expert. Provide clean code fixes with actual snippets.",
      architecture: "You are a software architect. Provide design pattern fixes with code.",
      dependency: "You are a dependency expert. Provide version fixes with configuration snippets."
    };
    return prompts[this.agentType] || prompts.quality;
  }

  selectModel(issue) {
    if (issue.complexity === 'low' || issue.severity === 'low') {
      return 'openai/gpt-3.5-turbo';
    }
    return 'anthropic/claude-3-haiku-20240307';
  }

  calculateConfidence(issue) {
    if (issue.tool === 'spotbugs' && issue.category === 'BAD_PRACTICE') return 'high';
    if (issue.tool === 'eslint' && issue.category === 'style') return 'high';
    if (issue.tool === 'pylint' && issue.category === 'convention') return 'high';
    return 'medium';
  }
}

module.exports = AgentService;
EOF
    echo "Created agent-service.js"; \
fi

# Set environment variables
ENV NODE_ENV=production \
    PORT=3000 \
    REDIS_URL=redis://redis:6379 \
    LOG_LEVEL=info

# Expose port
EXPOSE 3000

# Start the enhanced service
CMD ["node", "src/index.js"]