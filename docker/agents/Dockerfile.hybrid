FROM node:20-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache python3 py3-pip make g++ git

# Create package.json
RUN echo '{\
  "name": "@codequal/hybrid-agent-service",\
  "version": "1.0.0",\
  "description": "Hybrid agent service with caching",\
  "main": "dist/index.js",\
  "scripts": {\
    "start": "node dist/index.js",\
    "build": "tsc || true",\
    "dev": "node src/index.js"\
  }\
}' > package.json

# Install production dependencies
RUN npm install --save \
    openai@4.38.5 \
    ioredis@5.3.2 \
    @grpc/grpc-js@1.10.1 \
    @grpc/proto-loader@0.7.10 \
    winston@3.11.0 \
    dotenv@16.3.1 \
    express@4.18.2 \
    p-queue@7.4.1 \
    p-retry@5.1.2 \
    @supabase/supabase-js@2.39.3 \
    zod@3.22.4 \
    axios@1.6.7 \
    marked@11.1.1

# Create source directory
RUN mkdir -p src/agents src/cache src/utils

# Create hybrid cache service
RUN cat > src/cache-service.js << 'EOF'
const Redis = require('ioredis');
const crypto = require('crypto');

class HybridCacheService {
  constructor() {
    this.redis = new Redis(process.env.REDIS_URL || 'redis://localhost:6379');
    this.patterns = new Map();
    this.hitRate = { hits: 0, misses: 0 };
  }

  async getFixForIssue(issue) {
    const cacheKey = this.generateCacheKey(issue);

    try {
      // Check Redis cache
      const cached = await this.redis.get(cacheKey);
      if (cached) {
        this.hitRate.hits++;
        console.log(`Cache HIT for ${issue.type}:${issue.category} (${this.getHitRate()}% hit rate)`);
        return JSON.parse(cached);
      }

      this.hitRate.misses++;
      console.log(`Cache MISS for ${issue.type}:${issue.category} (${this.getHitRate()}% hit rate)`);
      return null;
    } catch (error) {
      console.error('Cache error:', error);
      return null;
    }
  }

  async storeFix(issue, fix) {
    const cacheKey = this.generateCacheKey(issue);
    const ttl = this.getTTL(issue);

    try {
      await this.redis.setex(cacheKey, ttl, JSON.stringify(fix));
      console.log(`Cached fix for ${issue.type}:${issue.category} (TTL: ${ttl}s)`);
    } catch (error) {
      console.error('Failed to cache fix:', error);
    }
  }

  generateCacheKey(issue) {
    const parts = [
      issue.tool || 'unknown',
      issue.type || 'unknown',
      issue.category || 'general',
      issue.language || 'any'
    ];
    return `fix:${parts.join(':')}:${crypto.createHash('md5').update(JSON.stringify(issue)).digest('hex')}`;
  }

  getTTL(issue) {
    // High-confidence patterns: 7 days
    if (issue.confidence === 'high') return 604800;
    // Medium confidence: 1 day
    if (issue.confidence === 'medium') return 86400;
    // Low confidence: 1 hour
    return 3600;
  }

  getHitRate() {
    const total = this.hitRate.hits + this.hitRate.misses;
    if (total === 0) return 0;
    return Math.round((this.hitRate.hits / total) * 100);
  }
}

module.exports = HybridCacheService;
EOF

# Create agent service
RUN cat > src/agent-service.js << 'EOF'
const OpenAI = require('openai');

class AgentService {
  constructor(agentType) {
    this.agentType = agentType;
    this.openai = new OpenAI({
      apiKey: process.env.OPENROUTER_API_KEY,
      baseURL: "https://openrouter.ai/api/v1"
    });
  }

  async generateFix(issue) {
    const prompt = this.buildPrompt(issue);

    try {
      const response = await this.openai.chat.completions.create({
        model: this.selectModel(issue),
        messages: [
          { role: "system", content: this.getSystemPrompt() },
          { role: "user", content: prompt }
        ],
        temperature: 0.3,
        max_tokens: 500
      });

      return {
        fix: response.choices[0].message.content,
        confidence: this.calculateConfidence(issue),
        explanation: `Fix generated by ${this.agentType} agent`,
        timestamp: new Date().toISOString()
      };
    } catch (error) {
      console.error(`Agent ${this.agentType} error:`, error);
      throw error;
    }
  }

  buildPrompt(issue) {
    return `Fix this ${issue.type} issue in ${issue.language}:
Tool: ${issue.tool}
Category: ${issue.category}
Message: ${issue.message}
File: ${issue.file}
Line: ${issue.line}

Generate a concise, actionable fix.`;
  }

  getSystemPrompt() {
    const prompts = {
      security: "You are a security expert. Provide secure code fixes.",
      performance: "You are a performance optimization expert. Provide efficient fixes.",
      quality: "You are a code quality expert. Provide clean, maintainable fixes.",
      architecture: "You are a software architect. Provide design pattern fixes.",
      dependency: "You are a dependency management expert. Provide version and compatibility fixes."
    };
    return prompts[this.agentType] || prompts.quality;
  }

  selectModel(issue) {
    // Use cheaper models for simple fixes
    if (issue.complexity === 'low') {
      return 'openai/gpt-3.5-turbo';
    }
    // Use better models for complex fixes
    return 'anthropic/claude-3-haiku-20240307';
  }

  calculateConfidence(issue) {
    if (issue.tool === 'spotbugs' && issue.category === 'BAD_PRACTICE') return 'high';
    if (issue.tool === 'eslint' && issue.category === 'style') return 'high';
    if (issue.tool === 'pylint' && issue.category === 'convention') return 'high';
    return 'medium';
  }
}

module.exports = AgentService;
EOF

# Create main server
RUN cat > src/index.js << 'EOF'
const express = require('express');
const HybridCacheService = require('./cache-service');
const AgentService = require('./agent-service');

const app = express();
app.use(express.json());

// Initialize services
const cache = new HybridCacheService();
const agents = {
  security: new AgentService('security'),
  performance: new AgentService('performance'),
  quality: new AgentService('quality'),
  architecture: new AgentService('architecture'),
  dependency: new AgentService('dependency')
};

// Health check
app.get('/health', async (req, res) => {
  try {
    await cache.redis.ping();
    res.json({
      status: 'healthy',
      service: 'hybrid-agent',
      redis: 'connected',
      agents: Object.keys(agents),
      cacheHitRate: cache.getHitRate() + '%'
    });
  } catch (error) {
    res.status(500).json({
      status: 'unhealthy',
      error: error.message
    });
  }
});

// Generate fix endpoint
app.post('/fix', async (req, res) => {
  const { issue } = req.body;

  if (!issue) {
    return res.status(400).json({ error: 'Issue data required' });
  }

  try {
    // Check cache first
    let fix = await cache.getFixForIssue(issue);

    if (!fix) {
      // Determine which agent to use
      const agentType = selectAgent(issue);
      const agent = agents[agentType];

      // Generate fix
      fix = await agent.generateFix(issue);

      // Store in cache
      await cache.storeFix(issue, fix);
    }

    res.json({
      success: true,
      fix,
      cached: !!fix.cached,
      cacheHitRate: cache.getHitRate() + '%'
    });
  } catch (error) {
    console.error('Fix generation error:', error);
    res.status(500).json({
      success: false,
      error: error.message
    });
  }
});

// Batch fix endpoint
app.post('/fix/batch', async (req, res) => {
  const { issues } = req.body;

  if (!issues || !Array.isArray(issues)) {
    return res.status(400).json({ error: 'Array of issues required' });
  }

  const results = [];
  let cached = 0;
  let generated = 0;

  for (const issue of issues) {
    try {
      // Check cache
      let fix = await cache.getFixForIssue(issue);

      if (fix) {
        cached++;
        fix.cached = true;
      } else {
        // Generate fix
        const agentType = selectAgent(issue);
        fix = await agents[agentType].generateFix(issue);
        await cache.storeFix(issue, fix);
        generated++;
      }

      results.push({ issue, fix, success: true });
    } catch (error) {
      results.push({ issue, error: error.message, success: false });
    }
  }

  res.json({
    success: true,
    results,
    stats: {
      total: issues.length,
      cached,
      generated,
      failed: results.filter(r => !r.success).length,
      cacheHitRate: cache.getHitRate() + '%'
    }
  });
});

// Stats endpoint
app.get('/stats', (req, res) => {
  res.json({
    cacheHitRate: cache.getHitRate() + '%',
    hits: cache.hitRate.hits,
    misses: cache.hitRate.misses,
    total: cache.hitRate.hits + cache.hitRate.misses
  });
});

function selectAgent(issue) {
  // Route to appropriate agent based on issue type
  if (issue.type === 'security' || issue.category?.includes('security')) {
    return 'security';
  }
  if (issue.type === 'performance' || issue.category?.includes('performance')) {
    return 'performance';
  }
  if (issue.type === 'architecture' || issue.category?.includes('design')) {
    return 'architecture';
  }
  if (issue.type === 'dependency' || issue.tool === 'npm-audit') {
    return 'dependency';
  }
  // Default to quality agent (handles 89% of issues)
  return 'quality';
}

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Hybrid Agent Service running on port ${PORT}`);
  console.log('Available agents:', Object.keys(agents));
  console.log('Redis URL:', process.env.REDIS_URL || 'redis://localhost:6379');
});
EOF

# Set environment variables with defaults
ENV NODE_ENV=production \
    PORT=3000 \
    REDIS_URL=redis://localhost:6379 \
    LOG_LEVEL=info

# Expose ports
EXPOSE 3000

# Start the service
CMD ["node", "src/index.js"]